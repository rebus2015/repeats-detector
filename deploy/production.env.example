# Copy to production.env; keep outside version control and restrict file access.
DATABASE_URL=postgres://repeats:REPLACE@db.example/repeats?sslmode=verify-full
RABBITMQ_URL=amqps://repeats:REPLACE@rabbit.example:5671/
S3_ENDPOINT=https://minio.example
AWS_REGION=us-east-1
OTEL_EXPORTER_OTLP_ENDPOINT=https://collector.example:4317
WORKERS=2
MAX_WAV_BYTES=128000000
MAX_FINGERPRINTS=1000000
MAX_SEARCH_HITS=200000
MAX_HASH_POSTINGS=32
TASK_TIMEOUT=2m
SEARCH_WINDOW=60m
INDEX_RETENTION=90m
TASK_RETENTION=168h
CLEANUP_INTERVAL=5m
AUTO_MIGRATE=false
