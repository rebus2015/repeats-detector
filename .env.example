DATABASE_URL=postgres://repeats:repeats@localhost:55432/repeats?sslmode=disable
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
INPUT_QUEUE=audio.tasks
OUTPUT_QUEUE=audio.results
DLQ_QUEUE=audio.tasks.dead
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=repeats-local
AWS_SECRET_ACCESS_KEY=repeats-local-secret
S3_ENDPOINT=http://localhost:9002
HTTP_ADDR=:8080
WORKERS=2
MAX_WAV_BYTES=128000000
MAX_FINGERPRINTS=1000000
MAX_SEARCH_HITS=200000
MAX_HASH_POSTINGS=32
TASK_TIMEOUT=2m
PUBLISH_TIMEOUT=10s
SHUTDOWN_TIMEOUT=30s
SEARCH_WINDOW=60m
INDEX_RETENTION=90m
TASK_RETENTION=168h
CLEANUP_INTERVAL=5m
MIN_MATCH_SECONDS=2
MIN_MATCH_FRAMES=12
MIN_MATCH_COVERAGE=0.08
MAX_MATCH_GAP_SECONDS=0.8
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SDK_DISABLED=true
REQUIRE_TLS=false
AUTO_MIGRATE=true
# Keep this name stable while reusing the RabbitMQ data volume.
RABBITMQ_HOSTNAME=rabbitmq

# Operational settings; duration values use Go syntax (ms, s, m).
RABBITMQ_CONNECT_TIMEOUT=10s
RABBITMQ_HEARTBEAT=10s
RABBITMQ_RECONNECT_DELAY=2s
TASK_DELIVERY_LIMIT=5
TASK_RETRY_DELAY=1s
OUTBOX_POLL_INTERVAL=100ms
OUTBOX_RETRY_DELAY=2s
DELIVERY_POLL_INTERVAL=100ms
STARTUP_TIMEOUT=30s
CLEANUP_TIMEOUT=30s
CLEANUP_PRINTS_BATCH_SIZE=50000
CLEANUP_TASKS_BATCH_SIZE=1000
LOG_LEVEL=INFO
OTEL_SDK_DISABLED=false
OTEL_SERVICE_NAME=repeats-detector
OTEL_RESOURCE_ATTRIBUTES=
OTEL_METRIC_EXPORT_INTERVAL=10000
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_TRACES_SAMPLER_ARG=

# OTEL_METRIC_EXPORT_INTERVAL is in milliseconds, not Go duration syntax.

# Optional container-side PostgreSQL DSN (host DATABASE_URL is for local CLI).
# COMPOSE_DATABASE_URL=postgres://repeats:repeats@postgres:5432/repeats?sslmode=disable&pool_max_conns=12

# Optional local check/smoke settings (read by Python tools, not the Go service).
# SERVICE_URL=http://localhost:8080
# RABBITMQ_MANAGEMENT_URL=http://localhost:15672
# RABBITMQ_MANAGEMENT_USER=guest
# RABBITMQ_MANAGEMENT_PASSWORD=guest
# GRAFANA_URL=http://localhost:3000
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=repeats-local-grafana
# PROMETHEUS_URL=http://localhost:9090
# SMOKE_S3_ENDPOINT=http://localhost:9000
# SMOKE_BUCKET=audio
